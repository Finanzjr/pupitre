/** Compara un archivo HTML del proyecto con la versión entregada. Devuelve null si es idéntico. */
function compararArchivo_(name, content) {
  const exp = HTML_FP_[name]; if (!exp) return null;
  const lines = content.replace(/\r/g, '').trim().split('\n').map(function (l) { return l.replace(/\s+$/, ''); });
  for (let i = 0; i < Math.max(lines.length, exp.length); i++) {
    if (i >= lines.length) return name + '.html está CORTADO: tiene ' + lines.length + ' líneas y deben ser ' + exp.length + '. Falta todo desde la línea ' + (i + 1) + '.';
    if (i >= exp.length) return name + '.html tiene ' + (lines.length - exp.length) + ' líneas de más al final (desde la línea ' + (i + 1) + '): «' + lines[i].slice(0, 120) + '».';
    if (fpHash_(lines[i]) !== exp[i] && i === lines.length - 1 && lines.length < exp.length) return name + '.html está CORTADO en la línea ' + (i + 1) + ' de ' + exp.length + ': termina en «' + lines[i].slice(-80) + '». Vuelve a pegarlo completo.';
    if (fpHash_(lines[i]) !== exp[i]) return name + '.html es distinto desde la línea ' + (i + 1) + ': «' + lines[i].slice(0, 160) + '». Vuelve a pegar el archivo completo.';
  }
  return null;
}

/** Primera línea distinta entre dos textos (para ver qué cambió Apps Script). */
function primeraDiferencia_(a, b) {
  const A = a.replace(/\r/g, '').split('\n'), B = b.replace(/\r/g, '').split('\n');
  for (let i = 0; i < Math.max(A.length, B.length); i++) {
    if ((A[i] || '').replace(/\s+$/, '') !== (B[i] || '').replace(/\s+$/, '')) {
      let k = 0; const x = A[i] || '', y = B[i] || ''; while (k < x.length && x[k] === y[k]) k++;
      const from = Math.max(0, k - 50);
      return 'Línea ' + (i + 1) + ' original: «' + x.slice(from, k + 70) + '» → servida: «' + y.slice(from, k + 70) + '»';
    }
  }
  return null;
}
